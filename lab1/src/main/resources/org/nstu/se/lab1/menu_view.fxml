<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.nstu.se.lab1.ui.menu.MenuController"
      styleClass="screen menu-screen">
    <fx:define>
        <ToggleGroup fx:id="modeGroup"/>
    </fx:define>

    <Label text="%menu.caption.mode" styleClass="screen-title"/>

    <HBox styleClass="segmented" maxWidth="-Infinity">
        <ToggleButton fx:id="manualToggle" styleClass="segment"
                      toggleGroup="$modeGroup" text="%menu.mode.manual" selected="true"/>
        <ToggleButton fx:id="generateToggle" styleClass="segment"
                      toggleGroup="$modeGroup" text="%menu.mode.generate"/>
    </HBox>

    <StackPane styleClass="menu-body">
        <VBox fx:id="manualPane" styleClass="manual-pane">
            <Label text="%menu.label.manual.hint"/>
            <TextField fx:id="array" promptText="%menu.prompt.manual"
                       styleClass="menu-input-wide"/>
            <Label fx:id="arrayError" styleClass="error-label"
                   managed="false" visible="false"/>
        </VBox>

        <VBox fx:id="generatePane" styleClass="generate-pane"
              visible="false" managed="false">
            <HBox styleClass="form-row">
                <Label text="%menu.label.count"/>
                <TextField fx:id="countField" styleClass="menu-input-small"/>
            </HBox>
            <Label fx:id="countError" styleClass="error-label"
                   managed="false" visible="false"/>

            <HBox styleClass="form-row">
                <Label text="%menu.label.min"/>
                <TextField fx:id="smallNum" styleClass="menu-input-small"/>
                <Label text="%menu.label.max"/>
                <TextField fx:id="bigNum" styleClass="menu-input-small"/>
            </HBox>
            <Label fx:id="smallNumError" styleClass="error-label"
                   managed="false" visible="false"/>
            <Label fx:id="bigNumError" styleClass="error-label"
                   managed="false" visible="false"/>
        </VBox>
    </StackPane>

    <VBox styleClass="preview-pane">
        <Label text="%menu.label.array.title" styleClass="muted-caption"/>
        <Label fx:id="myArray" styleClass="array-preview"/>
        <Button fx:id="startButton" text="%menu.button.start"
                onAction="#start" disable="true" styleClass="primary-button"/>
    </VBox>
</VBox>
