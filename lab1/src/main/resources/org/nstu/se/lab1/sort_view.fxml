<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Tooltip?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.nstu.se.lab1.ui.animation.SortController"
      alignment="TOP_CENTER"
      styleClass="sort-screen">
    <Pane fx:id="animationPane" styleClass="animation-pane" VBox.vgrow="ALWAYS"/>

    <VBox styleClass="speed-pane">
        <Label text="%sort.label.speed" styleClass="muted-caption"/>
        <Slider fx:id="speedSlider"
                min="0.1" max="2.0" value="1.0"
                showTickLabels="true" showTickMarks="true"
                majorTickUnit="0.5" minorTickCount="1"
                styleClass="speed-slider"/>
    </VBox>

    <HBox styleClass="controls">
        <Button fx:id="playPauseButton" onAction="#togglePlayPause" styleClass="icon-button"/>
        <Button fx:id="restartButton" onAction="#restart" text="%sort.button.restart" styleClass="icon-button">
            <tooltip>
                <Tooltip text="%sort.tooltip.restart"/>
            </tooltip>
        </Button>
        <Button text="%sort.button.back" onAction="#comeBack" styleClass="icon-button">
            <tooltip>
                <Tooltip text="%sort.tooltip.back"/>
            </tooltip>
        </Button>
    </HBox>
</VBox>
